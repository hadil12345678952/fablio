<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/fablio/db" VERSION="20260101" COMMENT="Fablio — résultats et progression">
  <TABLES>
    <TABLE NAME="local_fablio_results" COMMENT="Résultats de tentatives Fablio">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="attempt" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="correctcount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="questioncount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="grade" TYPE="float" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="maxgrade" TYPE="float" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="percent" TYPE="float" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="answers" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fablio_quiz_user" TYPE="unique" FIELDS="quizid, userid, attempt"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="fablio_quiz_idx" UNIQUE="false" FIELDS="quizid"/>
        <INDEX NAME="fablio_user_idx" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
