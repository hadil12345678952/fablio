# ---------------------------------------------------------------------------
# Variables d'environnement Fablio — à copier dans ".env" (jamais commité !)
# ---------------------------------------------------------------------------

# Local (développement) :
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Production Neon (exemple de forme — remplacez par VOTRE chaîne, présente dans
# Neon Console → Project → Connection Details → « Pooled connection ») :
# DATABASE_URL="postgresql://<utilisateur>:<mot-de-passe>@<hote-pooler>.c-6.eu-central-1.aws.neon.tech/<base>?sslmode=require"

# Options avancées (valeurs par défaut raisonnables si absentes) :
# PG_POOL_MAX=5        # taille du pool de connexions par fonction serverless
# PGSSL=1              # force SSL sans détection automatique de l'hôte

# ---------------------------------------------------------------------------
# Synthèse vocale (lecture des fables à voix haute) — TOUT EST FACULTATIF
# ---------------------------------------------------------------------------
# Sans aucune clé, Fablio utilise un service public gratuit (Google Translate
# TTS) et, en dernier recours, la voix intégrée du navigateur.
# Pour une voix de meilleure qualité, renseignez une clé OpenAI :
# OPENAI_API_KEY="sk-…"
# OPENAI_TTS_MODEL="gpt-4o-mini-tts"   # facultatif
# OPENAI_TTS_VOICE="shimmer"           # facultatif (alloy, nova, shimmer…)

# ---------------------------------------------------------------------------
# Récupération de mot de passe enseignant — TOUT EST FACULTATIF
#
# ⚠ POUR QUE LES ENSEIGNANTS REÇOIVENT RÉELLEMENT LE COURRIEL, LES DEUX
#   VARIABLES CI-DESSOUS SONT NÉCESSAIRES :
#     • RESEND_API_KEY      → sans elle, rien n'est envoyé : le lien est écrit
#                             dans les journaux du serveur (secours pour
#                             l'administrateur, pas pour l'utilisateur) ;
#     • COURRIEL_EXPEDITEUR → l'adresse par défaut « onboarding@resend.dev »
#                             n'est qu'une adresse de TEST : Resend refuse tout
#                             destinataire autre que le titulaire du compte
#                             (erreur 403 « You can only send testing emails to
#                             your own email address »). Vérifiez un domaine
#                             dans Resend puis indiquez ici une adresse de ce
#                             domaine (SPF/DKIM).
#   Diagnostic en une requête : GET /api/health → {"courriel":"resend"|"journal"}
#   Voir RECUPERATION.md et docs/environment-variables.md §4.
# ---------------------------------------------------------------------------
# RESEND_API_KEY="re_…"
# COURRIEL_EXPEDITEUR="Fablio <no-reply@votre-ecole.tn>"
# NEXT_PUBLIC_URL_SITE="https://votre-projet.vercel.app"   # recommandé : liens de courriel stables

# ---------------------------------------------------------------------------
# Anti-force-brute de la CONNEXION (ajout de l'audit 2026-10) — FACULTATIF
# ---------------------------------------------------------------------------
# Le bornage est actif par défaut : 5 échecs en 15 min ⇒ 10 min d'attente pour
# un enseignant ; 5 échecs en 10 min ⇒ 5 min pour un élève (clé = code+pseudo,
# un élève bloqué ne bloque pas sa classe). Compteur en BASE de données : il faut
# la table `tentatives_connexion` (npx drizzle-kit push ou node scripts/setup-db.mjs).
# Si la table manque, la connexion reste possible (dégradation ouverte) et
# GET /api/health le dit dans « bornage » / « schemaManquant ».
# FABLIO_CONNEXION_LIMITATION=off     # désactive le bornage (tests de charge, dépannage)
# FABLIO_CONNEXION_STRICT=1           # au contraire : REFUSER les connexions tant que
#                                     # le bornage n'est pas opérationnel (à réserver
#                                     # aux environnements où le schéma est garanti)
