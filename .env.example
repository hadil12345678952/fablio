# ---------------------------------------------------------------------------
# Variables d'environnement Fablio — à copier dans ".env" (jamais commité !)
# ---------------------------------------------------------------------------

# Local (développement) :
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Production Neon (exemple de forme — remplacez par VOTRE chaîne, présente dans
# Neon Console → Project → Connection Details → « Pooled connection ») :
# DATABASE_URL="postgresql://<utilisateur>:<mot-de-passe>@<hote-pooler>.c-6.eu-central-1.aws.neon.tech/<base>?sslmode=require"

# Options avancées (valeurs par défaut raisonnables si absentes) :
# PG_POOL_MAX=5        # taille du pool de connexions par fonction serverless
# PGSSL=1              # force SSL sans détection automatique de l'hôte

# ---------------------------------------------------------------------------
# Synthèse vocale (lecture des fables à voix haute) — TOUT EST FACULTATIF
# ---------------------------------------------------------------------------
# Sans aucune clé, Fablio utilise un service public gratuit (Google Translate
# TTS) et, en dernier recours, la voix intégrée du navigateur.
# Pour une voix de meilleure qualité, renseignez une clé OpenAI :
# OPENAI_API_KEY="sk-…"
# OPENAI_TTS_MODEL="gpt-4o-mini-tts"   # facultatif
# OPENAI_TTS_VOICE="shimmer"           # facultatif (alloy, nova, shimmer…)
