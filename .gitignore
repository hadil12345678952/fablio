*cookies.txt
cookies*.txt
ke.txt
kl.txt

# Divers
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo
.vercel

# Sauvegardes locales (dumps + exports) — hors dépôt : contiennent des hachages
/sauvegardes/

# Artefacts de compilation
tsconfig.tsbuildinfo
*.tsbuildinfo
