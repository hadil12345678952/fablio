{
  "name": "fablio",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:setup": "node scripts/setup-db.mjs",
    "db:push": "drizzle-kit push",
    "db:seed": "node scripts/seed.mjs",
    "db:blocs": "node scripts/migrer-blocs.mjs --execute",
    "demo:reset": "node scripts/reinitialiser-demo.mjs",
    "test:e2e": "node tests/e2e-fablio.mjs",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.38.0",
    "next": "16.4.1",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "version": "1.0.0",
  "description": "Fablio — plateforme éducative (français) pour l'apprentissage des fables à l'école primaire : fables et exercices créés par l'enseignant, élèves rejoignant la classe par code de parrainage, suivi statistique.",
  "engines": {
    "node": ">=20.9"
  }
}
